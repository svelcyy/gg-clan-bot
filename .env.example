# On Wispbyte you can add these on the Environment page instead of uploading this file.
# NEVER share the token with anyone or paste it into a chat.

DISCORD_TOKEN=paste-your-bot-token-here
GUILD_ID=000000000000000000

# Optional: staff channel where coin check results and the weekly roster check are posted.
# Right-click the channel > Copy Channel ID.
STAFF_CHANNEL_ID=

# Optional: channel for "New Clan Member" cards from /roster add (defaults to the staff channel).
ROSTER_LOG_CHANNEL_ID=

# Weekly roster check in the staff channel (on/off), day and hour (UTC; 17 = 1pm New York summer time)
WEEKLY_CHECK=on
REPORT_WEEKDAY=sunday
REPORT_HOUR_UTC=17

# Already set for [gg]; only change if something changes
DISCORD_MEMBER_ROLE=gg Member
ROBLOX_GROUP_ID=16909817
ROBLOX_MIN_RANK=75
ROBLOX_IGNORE_ROLES=UGC

# The bot's status text, and whether it shows with the phone (mobile) icon
BOT_STATUS=Checking coins...
MOBILE_STATUS=on
